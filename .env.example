# Copy to your environment (or Vercel project settings). Never commit real values.
DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=
JWT_SECRET=<base64 of at least 32 random bytes>
CRON_SECRET=<random string; Vercel Cron sends it as Bearer token>
CORS_ALLOWED_ORIGINS=https://<web-app-domain>,https://<landing-domain>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<gmail address>
SMTP_PASSWORD=<gmail app password>
MAIL_FROM=<gmail address>
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/<api-key>
ISSUER_PRIVATE_KEY=<issuer account private key>
CERTIFICATE_CONTRACT_ADDRESS=<ChambitaCertificate address on Sepolia>
VERIFICATION_PORTAL_URL=https://<verification-portal-domain>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service role key>
SUPABASE_BUCKET=chambita-files
SERVICE_FEE_RATE=0.10
